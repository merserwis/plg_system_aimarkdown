<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
    <name>PLG_SYSTEM_AIMARKDOWN</name>
    <author>Merserwis</author>
    <authorEmail>a.blazewicz@merserwis.pl</authorEmail>
    <authorUrl>https://github.com/merserwis/plg_system_aimarkdown/</authorUrl>
    <creationDate>2026-10-07</creationDate>
    <copyright>Copyright (C) 2026 Merserwis. All rights reserved.</copyright>
    <license>GNU Affero General Public License version 3 or later (AGPL-3.0-or-later)</license>
    <version>1.6.3</version>
    <description>PLG_SYSTEM_AIMARKDOWN_XML_DESCRIPTION</description>
    
    <namespace path="src">Merserwis\Plugin\System\AiMarkdown</namespace>
    
    <files>
        <folder plugin="aimarkdown">services</folder>
        <folder>src</folder>
        <filename>script.php</filename>
        <folder>language</folder>
    </files>

    <languages folder="language">
        <language tag="en-GB">en-GB/plg_system_aimarkdown.ini</language>
        <language tag="en-GB">en-GB/plg_system_aimarkdown.sys.ini</language>
        <language tag="de-DE">de-DE/plg_system_aimarkdown.ini</language>
        <language tag="de-DE">de-DE/plg_system_aimarkdown.sys.ini</language>
        <language tag="pl-PL">pl-PL/plg_system_aimarkdown.ini</language>
        <language tag="pl-PL">pl-PL/plg_system_aimarkdown.sys.ini</language>
        <language tag="fr-FR">fr-FR/plg_system_aimarkdown.ini</language>
        <language tag="fr-FR">fr-FR/plg_system_aimarkdown.sys.ini</language>
        <language tag="cs-CZ">cs-CZ/plg_system_aimarkdown.ini</language>
        <language tag="cs-CZ">cs-CZ/plg_system_aimarkdown.sys.ini</language>
        <language tag="nl-NL">nl-NL/plg_system_aimarkdown.ini</language>
        <language tag="nl-NL">nl-NL/plg_system_aimarkdown.sys.ini</language>
    </languages>
    
    <scriptfile>script.php</scriptfile>

    <config>
        <fields name="params">
            <fieldset name="basic" label="PLG_SYSTEM_AIMARKDOWN_FIELDSET_BASIC" addfieldprefix="Merserwis\Plugin\System\AiMarkdown\Field">
                <field name="help_tooltips" type="help" hiddenLabel="true" parentclass="d-none" />
                <field
                    name="extension_info"
                    type="note"
                    label="PLG_SYSTEM_AIMARKDOWN_EXTENSION_INFO_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_EXTENSION_INFO_DESC"
                    class="alert alert-info"
                />

                <field
                    name="enable_frontmatter"
                    type="radio"
                    label="PLG_SYSTEM_AIMARKDOWN_ENABLE_FRONTMATTER_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_ENABLE_FRONTMATTER_DESC"
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="enable_faq"
                    type="radio"
                    label="PLG_SYSTEM_AIMARKDOWN_ENABLE_FAQ_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_ENABLE_FAQ_DESC"
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="auto_generate_faq"
                    type="radio"
                    label="PLG_SYSTEM_AIMARKDOWN_AUTO_GENERATE_FAQ_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_AUTO_GENERATE_FAQ_DESC"
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                    filter="integer"
                    showon="enable_faq:1"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="prioritize_pdfs"
                    type="radio"
                    label="PLG_SYSTEM_AIMARKDOWN_PRIORITIZE_PDFS_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_PRIORITIZE_PDFS_DESC"
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="unroll_tabs_accordions"
                    type="radio"
                    label="PLG_SYSTEM_AIMARKDOWN_UNROLL_TABS_ACCORDIONS_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_UNROLL_TABS_ACCORDIONS_DESC"
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="enable_cache"
                    type="radio"
                    label="PLG_SYSTEM_AIMARKDOWN_ENABLE_CACHE_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_ENABLE_CACHE_DESC"
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="cache_time"
                    type="list"
                    label="PLG_SYSTEM_AIMARKDOWN_CACHE_TIME_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_CACHE_TIME_DESC"
                    default="86400"
                    showon="enable_cache:1"
                >
                    <option value="3600">PLG_SYSTEM_AIMARKDOWN_CACHE_TIME_OPT_3600</option>
                    <option value="21600">PLG_SYSTEM_AIMARKDOWN_CACHE_TIME_OPT_21600</option>
                    <option value="43200">PLG_SYSTEM_AIMARKDOWN_CACHE_TIME_OPT_43200</option>
                    <option value="86400">PLG_SYSTEM_AIMARKDOWN_CACHE_TIME_OPT_86400</option>
                    <option value="604800">PLG_SYSTEM_AIMARKDOWN_CACHE_TIME_OPT_604800</option>
                </field>

                <field
                    name="extra_query_params"
                    type="text"
                    label="PLG_SYSTEM_AIMARKDOWN_EXTRA_QUERY_PARAMS_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_EXTRA_QUERY_PARAMS_DESC"
                    default=""
                    filter="string"
                    hint="filter_brand, sort"
                />

                <field
                    name="custom_exclude_selectors"
                    type="textarea"
                    label="PLG_SYSTEM_AIMARKDOWN_CUSTOM_EXCLUDE_SELECTORS_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_CUSTOM_EXCLUDE_SELECTORS_DESC"
                    hint=".promo-banner&#10;#chat-widget&#10;aside&#10;div.popup&#10;//div[@data-banner]"
                    rows="6"
                    cols="50"
                    filter="raw"
                />

                <field
                    name="show_category"
                    type="radio"
                    label="PLG_SYSTEM_AIMARKDOWN_SHOW_CATEGORY_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_SHOW_CATEGORY_DESC"
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="show_tags"
                    type="radio"
                    label="PLG_SYSTEM_AIMARKDOWN_SHOW_TAGS_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_SHOW_TAGS_DESC"
                    layout="joomla.form.field.radio.switcher"
                    default="0"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="show_author"
                    type="radio"
                    label="PLG_SYSTEM_AIMARKDOWN_SHOW_AUTHOR_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_SHOW_AUTHOR_DESC"
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="show_date"
                    type="radio"
                    label="PLG_SYSTEM_AIMARKDOWN_SHOW_DATE_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_SHOW_DATE_DESC"
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="show_description"
                    type="radio"
                    label="PLG_SYSTEM_AIMARKDOWN_SHOW_DESCRIPTION_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_SHOW_DESCRIPTION_DESC"
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="show_images"
                    type="radio"
                    label="PLG_SYSTEM_AIMARKDOWN_SHOW_IMAGES_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_SHOW_IMAGES_DESC"
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="show_custom_fields"
                    type="radio"
                    label="PLG_SYSTEM_AIMARKDOWN_SHOW_CUSTOM_FIELDS_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_SHOW_CUSTOM_FIELDS_DESC"
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="show_alternate_link"
                    type="radio"
                    label="PLG_SYSTEM_AIMARKDOWN_SHOW_ALTERNATE_LINK_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_SHOW_ALTERNATE_LINK_DESC"
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="service_doc_path"
                    type="text"
                    label="PLG_SYSTEM_AIMARKDOWN_SERVICE_DOC_PATH_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_SERVICE_DOC_PATH_DESC"
                    default="kontakt"
                    filter="string"
                    showon="show_alternate_link:1"
                />
            </fieldset>

            <fieldset name="llmstxt" label="PLG_SYSTEM_AIMARKDOWN_FIELDSET_LLMSTXT" addfieldprefix="Merserwis\Plugin\System\AiMarkdown\Field">
                <field
                    name="enable_llmstxt"
                    type="radio"
                    label="PLG_SYSTEM_AIMARKDOWN_ENABLE_LLMSTXT_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_ENABLE_LLMSTXT_DESC"
                    layout="joomla.form.field.radio.switcher"
                    default="0"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="llms_site_title"
                    type="text"
                    label="PLG_SYSTEM_AIMARKDOWN_LLMS_SITE_TITLE_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_LLMS_SITE_TITLE_DESC"
                    hint="PLG_SYSTEM_AIMARKDOWN_LLMS_SITE_TITLE_HINT"
                    showon="enable_llmstxt:1"
                />

                <field
                    name="llms_site_summary"
                    type="textarea"
                    label="PLG_SYSTEM_AIMARKDOWN_LLMS_SITE_SUMMARY_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_LLMS_SITE_SUMMARY_DESC"
                    hint="PLG_SYSTEM_AIMARKDOWN_LLMS_SITE_SUMMARY_HINT"
                    rows="3"
                    cols="50"
                    filter="raw"
                    showon="enable_llmstxt:1"
                />

                <field
                    name="llms_auto_interval"
                    type="list"
                    label="PLG_SYSTEM_AIMARKDOWN_LLMS_AUTO_INTERVAL_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_LLMS_AUTO_INTERVAL_DESC"
                    default="86400"
                    showon="enable_llmstxt:1"
                >
                    <option value="43200">PLG_SYSTEM_AIMARKDOWN_LLMS_AUTO_INTERVAL_OPT_43200</option>
                    <option value="86400">PLG_SYSTEM_AIMARKDOWN_LLMS_AUTO_INTERVAL_OPT_86400</option>
                    <option value="432000">PLG_SYSTEM_AIMARKDOWN_LLMS_AUTO_INTERVAL_OPT_432000</option>
                    <option value="1296000">PLG_SYSTEM_AIMARKDOWN_LLMS_AUTO_INTERVAL_OPT_1296000</option>
                    <option value="2592000">PLG_SYSTEM_AIMARKDOWN_LLMS_AUTO_INTERVAL_OPT_2592000</option>
                </field>

                <field
                    name="llms_exclude_urls"
                    type="textarea"
                    label="PLG_SYSTEM_AIMARKDOWN_LLMS_EXCLUDE_URLS_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_LLMS_EXCLUDE_URLS_DESC"
                    hint="/koszyk&#10;/regulamin&#10;/polityka-prywatnosci"
                    rows="4"
                    cols="50"
                    filter="raw"
                    showon="enable_llmstxt:1"
                />

                <field
                    name="llms_sort_by"
                    type="list"
                    label="PLG_SYSTEM_AIMARKDOWN_LLMS_SORT_BY_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_LLMS_SORT_BY_DESC"
                    default="hits"
                    showon="enable_llmstxt:1"
                >
                    <option value="hits">PLG_SYSTEM_AIMARKDOWN_LLMS_SORT_BY_OPT_HITS</option>
                    <option value="date">PLG_SYSTEM_AIMARKDOWN_LLMS_SORT_BY_OPT_DATE</option>
                </field>

                <field
                    name="llms_max_items"
                    type="list"
                    label="PLG_SYSTEM_AIMARKDOWN_LLMS_MAX_ITEMS_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_LLMS_MAX_ITEMS_DESC"
                    default="750"
                    showon="enable_llmstxt:1"
                >
                    <option value="500">PLG_SYSTEM_AIMARKDOWN_LLMS_MAX_ITEMS_OPT_500</option>
                    <option value="750">PLG_SYSTEM_AIMARKDOWN_LLMS_MAX_ITEMS_OPT_750</option>
                    <option value="1000">PLG_SYSTEM_AIMARKDOWN_LLMS_MAX_ITEMS_OPT_1000</option>
                    <option value="2000">PLG_SYSTEM_AIMARKDOWN_LLMS_MAX_ITEMS_OPT_2000</option>
                    <option value="0">PLG_SYSTEM_AIMARKDOWN_LLMS_MAX_ITEMS_OPT_0</option>
                </field>

                <field
                    name="llms_menutype"
                    type="menu"
                    label="PLG_SYSTEM_AIMARKDOWN_LLMS_MENUTYPE_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_LLMS_MENUTYPE_DESC"
                    default=""
                    clientid="0"
                    showon="enable_llmstxt:1"
                >
                    <option value="">PLG_SYSTEM_AIMARKDOWN_LLMS_MENUTYPE_OPT_EMPTY</option>
                </field>

                <field
                    name="llms_gridbox_url_mode"
                    type="list"
                    label="PLG_SYSTEM_AIMARKDOWN_LLMS_GRIDBOX_URL_MODE_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_LLMS_GRIDBOX_URL_MODE_DESC"
                    default="menu"
                    showon="enable_llmstxt:1"
                >
                    <option value="menu">PLG_SYSTEM_AIMARKDOWN_LLMS_GRIDBOX_URL_MODE_OPT_MENU</option>
                    <option value="router">PLG_SYSTEM_AIMARKDOWN_LLMS_GRIDBOX_URL_MODE_OPT_ROUTER</option>
                    <option value="alias">PLG_SYSTEM_AIMARKDOWN_LLMS_GRIDBOX_URL_MODE_OPT_ALIAS</option>
                </field>

                <field
                    name="llms_action_dashboard"
                    type="llms"
                    showon="enable_llmstxt:1"
                />
            </fieldset>

            <fieldset name="merchant" label="PLG_SYSTEM_AIMARKDOWN_FIELDSET_MERCHANT">
                <field
                    name="enable_merchant_context"
                    type="radio"
                    label="PLG_SYSTEM_AIMARKDOWN_ENABLE_MERCHANT_CONTEXT_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_ENABLE_MERCHANT_CONTEXT_DESC"
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="merchant_info_legend"
                    type="note"
                    label="PLG_SYSTEM_AIMARKDOWN_MERCHANT_INFO_LEGEND_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_MERCHANT_INFO_LEGEND_DESC"
                    class="alert alert-info"
                    showon="enable_merchant_context:1"
                />

                <field
                    name="merchant_name"
                    type="text"
                    label="PLG_SYSTEM_AIMARKDOWN_MERCHANT_NAME_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_MERCHANT_NAME_DESC"
                    hint="PLG_SYSTEM_AIMARKDOWN_MERCHANT_NAME_HINT"
                    showon="enable_merchant_context:1"
                />

                <field
                    name="merchant_type"
                    type="text"
                    label="PLG_SYSTEM_AIMARKDOWN_MERCHANT_TYPE_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_MERCHANT_TYPE_DESC"
                    hint="PLG_SYSTEM_AIMARKDOWN_MERCHANT_TYPE_HINT"
                    showon="enable_merchant_context:1"
                />

                <field
                    name="vat_rate"
                    type="number"
                    label="PLG_SYSTEM_AIMARKDOWN_VAT_RATE_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_VAT_RATE_DESC"
                    default="23"
                    min="0"
                    max="100"
                    step="0.1"
                    filter="float"
                    showon="enable_merchant_context:1"
                />

                <field
                    name="merchant_header_text"
                    type="textarea"
                    label="PLG_SYSTEM_AIMARKDOWN_MERCHANT_HEADER_TEXT_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_MERCHANT_HEADER_TEXT_DESC"
                    hint="PLG_SYSTEM_AIMARKDOWN_MERCHANT_HEADER_TEXT_HINT"
                    rows="4"
                    cols="50"
                    filter="raw"
                    showon="enable_merchant_context:1"
                />

                <field
                    name="merchant_footer_text"
                    type="textarea"
                    label="PLG_SYSTEM_AIMARKDOWN_MERCHANT_FOOTER_TEXT_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_MERCHANT_FOOTER_TEXT_DESC"
                    hint="PLG_SYSTEM_AIMARKDOWN_MERCHANT_FOOTER_TEXT_HINT"
                    rows="7"
                    cols="50"
                    filter="raw"
                    showon="enable_merchant_context:1"
                />
            </fieldset>

            <fieldset name="analytics" label="PLG_SYSTEM_AIMARKDOWN_FIELDSET_ANALYTICS" addfieldprefix="Merserwis\Plugin\System\AiMarkdown\Field">
                <field
                    name="enable_analytics"
                    type="radio"
                    label="PLG_SYSTEM_AIMARKDOWN_ENABLE_ANALYTICS_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_ENABLE_ANALYTICS_DESC"
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="analytics_display_limit"
                    type="list"
                    label="PLG_SYSTEM_AIMARKDOWN_ANALYTICS_DISPLAY_LIMIT_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_ANALYTICS_DISPLAY_LIMIT_DESC"
                    default="10"
                    showon="enable_analytics:1"
                >
                    <option value="5">5</option>
                    <option value="10">PLG_SYSTEM_AIMARKDOWN_ANALYTICS_DISPLAY_LIMIT_OPT_10</option>
                    <option value="15">15</option>
                    <option value="30">30</option>
                </field>

                <field
                    name="log_retention_days"
                    type="list"
                    label="PLG_SYSTEM_AIMARKDOWN_LOG_RETENTION_DAYS_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_LOG_RETENTION_DAYS_DESC"
                    default="30"
                    showon="enable_analytics:1"
                >
                    <option value="7">PLG_SYSTEM_AIMARKDOWN_LOG_RETENTION_DAYS_OPT_7</option>
                    <option value="14">PLG_SYSTEM_AIMARKDOWN_LOG_RETENTION_DAYS_OPT_14</option>
                    <option value="30">PLG_SYSTEM_AIMARKDOWN_LOG_RETENTION_DAYS_OPT_30</option>
                    <option value="60">PLG_SYSTEM_AIMARKDOWN_LOG_RETENTION_DAYS_OPT_60</option>
                    <option value="90">PLG_SYSTEM_AIMARKDOWN_LOG_RETENTION_DAYS_OPT_90</option>
                </field>

                <field
                    name="trust_proxy_headers"
                    type="radio"
                    label="PLG_SYSTEM_AIMARKDOWN_TRUST_PROXY_HEADERS_LABEL"
                    description="PLG_SYSTEM_AIMARKDOWN_TRUST_PROXY_HEADERS_DESC"
                    layout="joomla.form.field.radio.switcher"
                    default="0"
                    filter="integer"
                    showon="enable_analytics:1"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="analytics_dashboard"
                    type="analytics"
                    showon="enable_analytics:1"
                />
            </fieldset>

            <fieldset name="backup" label="PLG_SYSTEM_AIMARKDOWN_FIELDSET_BACKUP" addfieldprefix="Merserwis\Plugin\System\AiMarkdown\Field">
                <field
                    name="settings_file"
                    type="settingsfile"
                    hiddenLabel="true"
                />
            </fieldset>
        </fields>
    </config>

    <updateservers>
        <server type="extension" priority="1" name="AI Markdown for Gridbox Updates">
            https://raw.githubusercontent.com/merserwis/plg_system_aimarkdown/refs/heads/main/update.xml
        </server>
    </updateservers>
</extension>