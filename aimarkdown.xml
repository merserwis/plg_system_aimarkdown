<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
    <name>System - AI Markdown for Gridbox</name>
    <author>Merserwis</author>
    <authorEmail>a.blazewicz@merserwis.pl</authorEmail>
    <authorUrl>https://github.com/merserwis/plg_system_aimarkdown/</authorUrl>
    <creationDate>2026-09-21</creationDate>
    <copyright>Copyright (C) 2026 Merserwis. All rights reserved.</copyright>
    <license>GNU Affero General Public License version 3 or later (AGPL-3.0-or-later)</license>
    <version>1.3.3</version>
    <description>Native Markdown plugin for Joomla 6 and PHP 8.5 with high-performance caching, YAML Frontmatter, tab/accordion unrolling, PDF prioritization, and local AI analytics.</description>
    
    <namespace path="src">Merserwis\Plugin\System\AiMarkdown</namespace>
    
    <files>
        <folder plugin="aimarkdown">services</folder>
        <folder>src</folder>
        <filename>script.php</filename>
    </files>
    
    <scriptfile>script.php</scriptfile>

    <config>
        <fields name="params">
            <fieldset name="basic" label="Settings">
                <field
                    name="extension_info"
                    type="note"
                    label="Project &amp; Support"
                    description="&lt;p class=&quot;mb-1&quot;&gt;&lt;strong&gt;Repository &amp; Docs:&lt;/strong&gt; &lt;a href=&quot;https://github.com/merserwis/plg_system_aimarkdown/&quot; target=&quot;_blank&quot; rel=&quot;noopener noreferrer&quot;&gt;https://github.com/merserwis/plg_system_aimarkdown/&lt;/a&gt;&lt;/p&gt;&lt;p class=&quot;mb-0&quot;&gt;&lt;strong&gt;Contact:&lt;/strong&gt; &lt;a href=&quot;mailto:a.blazewicz@merserwis.pl&quot;&gt;a.blazewicz@merserwis.pl&lt;/a&gt; | &lt;strong&gt;License:&lt;/strong&gt; AGPL-3.0&lt;/p&gt;"
                    class="alert alert-info"
                />

                <field
                    name="enable_frontmatter"
                    type="radio"
                    label="Enable YAML Frontmatter"
                    description="Prepend structured YAML metadata (title, price, SKU, availability, category, downloads) at the top of the Markdown for LLMs."
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="prioritize_pdfs"
                    type="radio"
                    label="Prioritize PDF Downloads"
                    description="Extract all PDF links (datasheets, manuals, catalogs), convert them to absolute URLs, and list them under a dedicated 'Downloads &amp; Documentation' section."
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="unroll_tabs_accordions"
                    type="radio"
                    label="Extract Tabs &amp; Accordions"
                    description="Unroll hidden tabs and collapsed accordions into clean sequential Markdown headings and sections for AI agents."
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="enable_cache"
                    type="radio"
                    label="Enable Markdown Cache"
                    description="Store converted Markdown files in cache to serve AI agents in milliseconds and reduce server load."
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="cache_time"
                    type="list"
                    label="Cache Lifetime"
                    description="How long cached Markdown files should remain valid before regenerating."
                    default="86400"
                    showon="enable_cache:1"
                >
                    <option value="3600">1 Hour</option>
                    <option value="21600">6 Hours</option>
                    <option value="43200">12 Hours</option>
                    <option value="86400">24 Hours (Recommended)</option>
                    <option value="604800">7 Days</option>
                </field>

                <field
                    name="custom_exclude_selectors"
                    type="textarea"
                    label="Custom Exclude Selectors"
                    description="Enter one selector per line to strip matching elements from Markdown. Supported formats:&#10;• CSS Class: .promo-banner, .newsletter-popup&#10;• CSS ID: #live-chat, #cookie-bar&#10;• HTML Tag: aside, dialog&#10;• Tag with Class: div.popup, section.advert&#10;• XPath: //div[@data-banner='true']"
                    hint=".promo-banner&#10;#chat-widget&#10;aside&#10;div.popup&#10;//div[@data-banner]"
                    rows="6"
                    cols="50"
                    filter="raw"
                />

                <field
                    name="show_category"
                    type="radio"
                    label="Show Category"
                    description="Display the post or product category in the generated Markdown."
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="show_tags"
                    type="radio"
                    label="Show Tags"
                    description="Display tags in the generated Markdown."
                    layout="joomla.form.field.radio.switcher"
                    default="0"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="show_author"
                    type="radio"
                    label="Show Author"
                    description="Display the author in the generated Markdown."
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="show_date"
                    type="radio"
                    label="Show Date"
                    description="Display the publication date in the generated Markdown."
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="show_description"
                    type="radio"
                    label="Show Description"
                    description="Display the main post or product description in the generated Markdown."
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="show_images"
                    type="radio"
                    label="Show Images"
                    description="Include images in the generated Markdown."
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="show_custom_fields"
                    type="radio"
                    label="Show Custom Fields"
                    description="Display custom fields and product technical specifications from Balbooa Gridbox."
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="show_alternate_link"
                    type="radio"
                    label="Show Alternate Link"
                    description="Add the RFC 8288 Link header and the rel=alternate link tag in the HTML head section."
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
            </fieldset>

            <fieldset name="analytics" label="AI Analytics" addfieldprefix="Merserwis\Plugin\System\AiMarkdown\Field">
                <field
                    name="enable_analytics"
                    type="radio"
                    label="Enable AI Analytics"
                    description="Log visits from AI bots (GPTBot, ClaudeBot, Perplexity) locally in your database."
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="analytics_display_limit"
                    type="list"
                    label="Analytics Display Limit"
                    description="Select how many top bots, top visited pages, and recent requests to display in the dashboard."
                    default="10"
                    showon="enable_analytics:1"
                >
                    <option value="5">5</option>
                    <option value="10">10 (Default)</option>
                    <option value="15">15</option>
                    <option value="30">30</option>
                </field>

                <field
                    name="log_retention_days"
                    type="list"
                    label="Log Retention"
                    description="Automatically purge logs older than specified number of days."
                    default="30"
                    showon="enable_analytics:1"
                >
                    <option value="7">7 Days</option>
                    <option value="14">14 Days</option>
                    <option value="30">30 Days (Recommended)</option>
                    <option value="60">60 Days</option>
                    <option value="90">90 Days</option>
                </field>

                <field
                    name="analytics_dashboard"
                    type="analytics"
                    showon="enable_analytics:1"
                />
            </fieldset>
        </fields>
    </config>

    <updateservers>
        <server type="extension" priority="1" name="AI Markdown for Gridbox Updates">
            https://raw.githubusercontent.com/merserwis/plg_system_aimarkdown/refs/heads/main/update.xml
        </server>
    </updateservers>
</extension>